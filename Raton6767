-- LÓGICA DE ESP ORIGINAL (SIN CAMBIOS)
local function createESP(model)
if espObjects[model] then return end
local box = Drawing.new("Square")
box.Visible = false
box.Color = ESP_COLOR
box.Thickness = LINE_THICKNESS
box.Filled = false
local text = Drawing.new("Text")
text.Visible = false
text.Color = TEXT_COLOR
text.Size = 18
text.Center = true
text.Outline = true
espObjects[model] = {Box = box, Text = text}
end
local function removeESP(model)
if espObjects[model] then
espObjects[model].Box:Remove(); espObjects[model].Text:Remove(); espObjects[model] = nil
end
lastPositions[model] = nil; movementTimers[model] = nil
end
local function isMonsterModel(model)
if not model:IsA("Model") then return false end
if model == LocalPlayer.Character then return false end
local rootPart = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
if rootPart and not Players:GetPlayerFromCharacter(model) then return true end
return false
end
RunService.RenderStepped:Connect(function()
local currentTime = os.clock()
for _, model in ipairs(Workspace:GetDescendants()) do
if isMonsterModel(model) then
local rootPart = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
if rootPart then
local currentPos = rootPart.Position
local lastPos = lastPositions[model]
if not movementTimers[model] then movementTimers[model] = 0 end
if lastPos then
local velocity = (currentPos - lastPos).Magnitude
if velocity > MIN_SPEED_THRESHOLD then movementTimers[model] = currentTime end
end
lastPositions[model] = currentPos
if ESP_ENABLED and ((currentTime - movementTimers[model]) <= COOLDOWN_TIME) then
createESP(model)
local data = espObjects[model]
if data then
local screenPos, onScreen = Camera:WorldToViewportPoint(currentPos)
if onScreen then
local distance = (Camera.CFrame.Position - currentPos).Magnitude
local sizeX = math.clamp(2500 / distance, 10, 300)
local sizeY = math.clamp(3800 / distance, 15, 400)
data.Box.Size = Vector2.new(sizeX, sizeY)
data.Box.Position = Vector2.new(screenPos.X - (sizeX / 2), screenPos.Y - (sizeY / 2))
data.Box.Visible = true
data.Text.Text = "⚠️ [ENEMIGO] " .. model.Name
data.Text.Position = Vector2.new(screenPos.X, screenPos.Y - (sizeY / 2) - 22)
data.Text.Visible = true
else
data.Box.Visible = false; data.Text.Visible = false
end
end
else
if espObjects[model] then
espObjects[model].Box.Visible = false
espObjects[model].Text.Visible = false
end
end
end
else
if espObjects[model] then removeESP(model) end
end
end
end)
Workspace.DescendantRemoving:Connect(function(descendant)
if espObjects[descendant] then removeESP(descendant) end
end)
end
