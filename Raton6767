local function iniciarScriptOriginal()
    -- Destruir la ventana de ingreso
    LoginFrame:Destroy()

    -- Habilitar y mostrar los componentes de tu script intacto
    MainFrame.Active = true
    MainFrame.Visible = true
    MobileMenuButton.Active = true
    MobileMenuButton.Visible = true

    -- Asignar arrastre táctil a tu menú e icono original
    makeDraggable(MainFrame)
    makeDraggable(MobileMenuButton)

    -- Sistema de Toque Inteligente de tu script original
    local touchStartX, touchStartY
    local totalDelta = 0

    MobileMenuButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            touchStartX = input.Position.X
            touchStartY = input.Position.Y
            totalDelta = 0
        end
    end)



MobileMenuButton.InputChanged:Connect(function(input)
if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and touchStartX then
local currentX = input.Position.X
local currentY = input.Position.Y
totalDelta = totalDelta + math.abs(currentX - touchStartX) + math.abs(currentY - touchStartY)
end
end)
MobileMenuButton.InputEnded:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
if totalDelta < 15 then
MainFrame.Visible = not MainFrame.Visible
end
touchStartX = nil
touchStartY = nil
end
end)
